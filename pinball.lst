     540   00:4264  78                          ld      a,b
     541   00:4265  E6 F8                       and     0f8h
     542   00:4267  C6 07                       add     a,7
     543   00:4269  67                          ld      h,a
     544   00:426A  2E 00                       ld      l,0
     545   00:426C  22 00 C0                    ld      (BALL_X),hl
     546   00:426F  2A 04 C0                    ld      hl,(BALL_VX)
     547   00:4272  CD D0 43                    call    NegateAndDamp
     548   00:4275  22 04 C0                    ld      (BALL_VX),hl
