    1064   00:4583  C6 08                       add     a,8
    1065   00:4585  DD 96 02                    sub     (ix+2)
    1066   00:4588  57                          ld      d,a                  ; retain signed vertical side
    1067   00:4589  32 10 C0                    ld      (BALL_HIT_Y),a
    1068   00:458C  CD 9A 48                    call    AbsA
    1069   00:458F  32 1E C0                    ld      (ABS_HIT_Y),a
    1070   00:4592  4F                          ld      c,a
    1071   00:4593  3A 18 C0                    ld      a,(OBJECT_RADIUS)
