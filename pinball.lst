    2105   00:4C3C  7A                          ld      a,d
    2106   00:4C3D  32 23 C0                    ld      (OBJECT_ANIM_SOURCE_X),a
    2107   00:4C40  78                          ld      a,b
    2108   00:4C41  32 24 C0                    ld      (OBJECT_ANIM_TARGET_X),a
    2109   00:4C44  79                          ld      a,c
    2110   00:4C45  32 25 C0                    ld      (OBJECT_ANIM_TARGET_Y),a
