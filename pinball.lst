     165   00:4044                      ReadControls:
     166   00:4044                              ; Rebuild the input state every frame instead of toggling it. This also
     167   00:4044                              ; makes releasing a key immediately start the flipper's return frames.
     168   00:4044  AF                          xor     a
     169   00:4045  32 0A C0                    ld      (LEFT_ACTIVE),a
     170   00:4048  32 0B C0                    ld      (RIGHT_ACTIVE),a
     171   00:404B                      
     172   00:404B                              ; GTSTCK returns an 8-direction number. Prefer cursor keys (port 0),
     173   00:404B                              ; then read joystick port 1 when the keyboard direction is idle.
     174   00:404B  AF                          xor     a
     175   00:404C  CD D5 00                    call    GTSTCK
     176   00:404F  B7                          or      a
     177   00:4050  20 05                       jr      nz,.directionReady
     178   00:4052  3E 01                       ld      a,1
     179   00:4054  CD D5 00                    call    GTSTCK
     180   00:4057                      .directionReady:
     181   00:4057  4F                          ld      c,a
     182   00:4058  FE 07                       cp      7                    ; left
     183   00:405A  28 08                       jr      z,.left
     184   00:405C  FE 08                       cp      8                    ; up-left
     185   00:405E  28 04                       jr      z,.left
     186   00:4060  FE 06                       cp      6                    ; down-left
     187   00:4062  20 05                       jr      nz,.testRight
     188   00:4064                      .left:
     189   00:4064  3E 01                       ld      a,1
     190   00:4066  32 0A C0                    ld      (LEFT_ACTIVE),a
     191   00:4069                      
     192   00:4069                      .testRight:
     193   00:4069  79                          ld      a,c
     194   00:406A  FE 03                       cp      3                    ; right
     195   00:406C  28 08                       jr      z,.right
     196   00:406E  FE 02                       cp      2                    ; up-right
     197   00:4070  28 04                       jr      z,.right
     198   00:4072  FE 04                       cp      4                    ; down-right
     199   00:4074  20 05                       jr      nz,.triggers
     200   00:4076                      .right:
     201   00:4076  3E 01                       ld      a,1
     202   00:4078  32 0B C0                    ld      (RIGHT_ACTIVE),a
     203   00:407B                      
     204   00:407B                      .triggers:
     205   00:407B                              ; Space and joystick trigger A operate both flippers. StepBall also
     206   00:407B                              ; treats either active flipper as the launch button while waiting.
     207   00:407B  AF                          xor     a                    ; space bar
     208   00:407C  CD D8 00                    call    GTTRIG
     209   00:407F  F5                          push    af
     210   00:4080  3E 01                       ld      a,1                  ; joystick 1 trigger A
     211   00:4082  CD D8 00                    call    GTTRIG
     212   00:4085  C1                          pop     bc                   ; B = space-bar result
     213   00:4086  B0                          or      b
     214   00:4087  C8                          ret     z
     215   00:4088  3E 01                       ld      a,1
     216   00:408A  32 0A C0                    ld      (LEFT_ACTIVE),a
     217   00:408D  32 0B C0                    ld      (RIGHT_ACTIVE),a
     218   00:4090  C9                          ret
     219   00:4091                      
     220   00:4091                      ; Advance one pivot-aligned bitmap frame per display frame. Pressing moves
     221   00:4091                      ; 0->1->2; releasing plays the same source frames backwards, 2->1->0.
     222   00:4091                      UpdateFlipperAnimations:
     223   00:4091                              ; LEFT/RIGHT_KICK are one-frame edge signals, not held-button signals.
     224   00:4091                              ; Physics therefore adds a strong kick only while a frame moves upward;
     225   00:4091                              ; a ball resting on an already raised flipper merely rolls downhill.
     226   00:4091  AF                          xor     a
     227   00:4092  32 16 C0                    ld      (LEFT_KICK),a
     228   00:4095  32 17 C0                    ld      (RIGHT_KICK),a
     229   00:4098  57                          ld      d,a                  ; nonzero when at least one frame changes
     230   00:4099                      
     231   00:4099  3A 11 C0                    ld      a,(LEFT_FRAME)
     232   00:409C  47                          ld      b,a
     233   00:409D  3A 0A C0                    ld      a,(LEFT_ACTIVE)
     234   00:40A0  B7                          or      a
     235   00:40A1  78                          ld      a,b
     236   00:40A2  28 10                       jr      z,.leftRelease
     237   00:40A4  FE 02                       cp      2
     238   00:40A6  30 12                       jr      nc,.leftStore
     239   00:40A8  3C                          inc     a
     240   00:40A9  16 01                       ld      d,1
     241   00:40AB  4F                          ld      c,a
     242   00:40AC  3E 01                       ld      a,1
     243   00:40AE  32 16 C0                    ld      (LEFT_KICK),a
     244   00:40B1  79                          ld      a,c
     245   00:40B2  18 06                       jr      .leftStore
     246   00:40B4                      .leftRelease:
     247   00:40B4  B7                          or      a
     248   00:40B5  28 03                       jr      z,.leftStore
     249   00:40B7  3D                          dec     a
     250   00:40B8  16 01                       ld      d,1
     251   00:40BA                      .leftStore:
     252   00:40BA  32 11 C0                    ld      (LEFT_FRAME),a
     253   00:40BD                      
     254   00:40BD  3A 12 C0                    ld      a,(RIGHT_FRAME)
     255   00:40C0  47                          ld      b,a
     256   00:40C1  3A 0B C0                    ld      a,(RIGHT_ACTIVE)
     257   00:40C4  B7                          or      a
     258   00:40C5  78                          ld      a,b
     259   00:40C6  28 10                       jr      z,.rightRelease
     260   00:40C8  FE 02                       cp      2
     261   00:40CA  30 12                       jr      nc,.rightStore
     262   00:40CC  3C                          inc     a
     263   00:40CD  16 01                       ld      d,1
     264   00:40CF  4F                          ld      c,a
     265   00:40D0  3E 01                       ld      a,1
     266   00:40D2  32 17 C0                    ld      (RIGHT_KICK),a
     267   00:40D5  79                          ld      a,c
     268   00:40D6  18 06                       jr      .rightStore
     269   00:40D8                      .rightRelease:
     270   00:40D8  B7                          or      a
     271   00:40D9  28 03                       jr      z,.rightStore
     272   00:40DB  3D                          dec     a
     273   00:40DC  16 01                       ld      d,1
     274   00:40DE                      .rightStore:
     275   00:40DE  32 12 C0                    ld      (RIGHT_FRAME),a
     276   00:40E1  7A                          ld      a,d
     277   00:40E2  B7                          or      a
     278   00:40E3  C8                          ret     z                    ; static frames need no repeated VRAM copy
     279   00:40E4  C3 D3 4D                    jp      DrawFlippers
     280   00:40E7                      
     281   00:40E7                      ; Rotate once per three horizontal pixels travelled. Positive VX advances
     282   00:40E7                      ; clockwise (top -> top-right -> right); negative VX plays the frames backward.
     283   00:40E7                      ; Accumulating 8.8 distance keeps slow rolling smooth without overspinning.
     284   00:40E7                      UpdateBallAnimation:
     285   00:40E7                              ; Animation is distance based rather than time based. A stationary ball
     286   00:40E7                              ; keeps its current artwork and a faster ball rotates more quickly.
     287   00:40E7  3A 08 C0                    ld      a,(BALL_WAITING)
     288   00:40EA  B7                          or      a
     289   00:40EB  C0                          ret     nz
     290   00:40EC  2A 04 C0                    ld      hl,(BALL_VX)
     291   00:40EF  7C                          ld      a,h
     292   00:40F0  B5                          or      l
     293   00:40F1  C8                          ret     z
     294   00:40F2  CB 7C                       bit     7,h
     295   00:40F4  28 06                       jr      z,.magnitudeReady
     296   00:40F6  AF                          xor     a
     297   00:40F7  95                          sub     l
     298   00:40F8  6F                          ld      l,a
     299   00:40F9  9F                          sbc     a,a
     300   00:40FA  94                          sub     h
     301   00:40FB  67                          ld      h,a
     302   00:40FC                      .magnitudeReady:
     303   00:40FC                              ; Rolling follows the full horizontal distance travelled this frame.
     304   00:40FC  ED 5B 14 C0                 ld      de,(BALL_ROLL_ACCUM)
     305   00:4100  19                          add     hl,de
     306   00:4101  7C                          ld      a,h
     307   00:4102  FE 03                       cp      3                    ; one eighth-turn per 3 pixels
     308   00:4104  38 21                       jr      c,.storeDistance
     309   00:4106  11 00 03                    ld      de,0300h
     310   00:4109  B7                          or      a
     311   00:410A  ED 52                       sbc     hl,de
     312   00:410C  22 14 C0                    ld      (BALL_ROLL_ACCUM),hl
     313   00:410F                      
     314   00:410F  2A 04 C0                    ld      hl,(BALL_VX)
     315   00:4112  3A 13 C0                    ld      a,(BALL_FRAME)
     316   00:4115  CB 7C                       bit     7,h
     317   00:4117  20 07                       jr      nz,.counterClockwise
     318   00:4119  3C                          inc     a
     319   00:411A  E6 07                       and     7
     320   00:411C  32 13 C0                    ld      (BALL_FRAME),a
     321   00:411F  C9                          ret
     322   00:4120                      .counterClockwise:
     323   00:4120  3D                          dec     a
     324   00:4121  E6 07                       and     7
     325   00:4123  32 13 C0                    ld      (BALL_FRAME),a
     326   00:4126  C9                          ret
     327   00:4127                      .storeDistance:
     328   00:4127  22 14 C0                    ld      (BALL_ROLL_ACCUM),hl
     329   00:412A  C9                          ret
     330   00:412B                      
     331   00:412B                      ; Four collision substeps together move one complete stored velocity.
     332   00:412B                      ; Input DE=velocity and HL=current position; output DE=velocity/4, HL kept.
     333   00:412B                      ScaleSubstepDelta:
     334   00:412B  E5                          push    hl
     335   00:412C  62                          ld      h,d
     336   00:412D  6B                          ld      l,e
     337   00:412E  CB 2C                       sra     h
     338   00:4130  CB 1D                       rr      l
     339   00:4132  CB 2C                       sra     h
     340   00:4134  CB 1D                       rr      l                   ; / 4 for one of four substeps
     341   00:4136  EB                          ex      de,hl
     342   00:4137  E1                          pop     hl
     343   00:4138  C9                          ret
