    1021   00:453D                      ; Tiled PinballObjects. Each eight-byte record is:
    1022   00:453D                      ; type, centre X, centre Y, radius, kick, score low/high, animation-atlas X.
    1023   00:453D                      ; Type 0 is a passive post; type 1 is a bumper (kick 0 is also passive).
    1024   00:453D                      CheckMapCircles:
    1025   00:453D  CD 30 46                    call    MaybeRearmLastBumper
    1026   00:4540  DD 21 4E 74                 ld      ix,CircleObjects+1
    1027   00:4544  3A 4D 74                    ld      a,(CircleObjects)
    1028   00:4547  B7                          or      a
    1029   00:4548  C8                          ret     z
    1030   00:4549                      .haveObjects:
    1031   00:4549  47                          ld      b,a
    1032   00:454A                      .loop:
    1033   00:454A                              ; Broad phase: compare absolute X/Y distances with the combined radius.
    1034   00:454A                              ; Only candidates inside that square need the more expensive squares.
    1035   00:454A  DD 7E 03                    ld      a,(ix+3)
    1036   00:454D  C6 07                       add     a,7                  ; object radius + effective ball radius
    1037   00:454F  FE 14                       cp      20                   ; SquareTable currently covers 0..19
    1038   00:4551  38 02                       jr      c,.radiusReady
    1039   00:4553  3E 13                       ld      a,19
    1040   00:4555                      .radiusReady:
    1041   00:4555  32 18 C0                    ld      (OBJECT_RADIUS),a
    1042   00:4558  CD A0 48                    call    SquareA
    1043   00:455B  22 19 C0                    ld      (OBJECT_RADIUS_SQ),hl
    1044   00:455E                      
    1045   00:455E  3A 01 C0                    ld      a,(BALL_X+1)
    1046   00:4561  C6 08                       add     a,8                  ; the smaller ball remains centred in 16x16
    1047   00:4563  DD 96 01                    sub     (ix+1)
    1048   00:4566  4F                          ld      c,a                  ; retain signed horizontal side
    1049   00:4567  32 0F C0                    ld      (BALL_HIT_X),a
    1050   00:456A  CD 9A 48                    call    AbsA
    1051   00:456D  32 1D C0                    ld      (ABS_HIT_X),a
    1052   00:4570  4F                          ld      c,a
    1053   00:4571  3A 18 C0                    ld      a,(OBJECT_RADIUS)
    1054   00:4574  57                          ld      d,a
    1055   00:4575  79                          ld      a,c
    1056   00:4576  BA                          cp      d
