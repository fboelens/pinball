     486   00:421A                      ; Static collision_shape values generated from maps/pinball.tsx:
     487   00:421A                      ;   0 empty, 1 solid, 2 ceiling, 3 floor, 4 left wall, 5 right wall,
     488   00:421A                      ;   6 slash diagonal and 7 backslash diagonal. Shape 8 is compiled into a
     489   00:421A                      ;   circle object by the build tool and therefore becomes 0 in CollisionMap.
     490   00:421A                      ;
     491   00:421A                      ; Resolve horizontal movement against the leading point of the ball. Shape 1
     492   00:421A                      ; is solid from every side; shape 4 is the left table boundary and shape 5 the
     493   00:421A                      ; right boundary. The 4 physics substeps keep this point test from tunnelling.
     494   00:421A                      ResolveTileX:
     495   00:421A  2A 04 C0                    ld      hl,(BALL_VX)
     496   00:421D  7C                          ld      a,h
     497   00:421E  B5                          or      l
     498   00:421F  C8                          ret     z
     499   00:4220  CB 7C                       bit     7,h
     500   00:4222  20 2B                       jr      nz,.movingLeft
     501   00:4224                      
     502   00:4224  3A 01 C0                    ld      a,(BALL_X+1)
     503   00:4227  C6 0F                       add     a,15                 ; rightmost circle point
     504   00:4229  47                          ld      b,a
     505   00:422A  3A 03 C0                    ld      a,(BALL_Y+1)
     506   00:422D  C6 08                       add     a,8
     507   00:422F  4F                          ld      c,a
     508   00:4230  CD AA 43                    call    GetCollisionShape
     509   00:4233  FE 01                       cp      1
     510   00:4235  28 03                       jr      z,.hitRightWall
     511   00:4237  FE 05                       cp      5
     512   00:4239  C0                          ret     nz
     513   00:423A                      .hitRightWall:
     514   00:423A                              ; Snap the sprite just outside the occupied 8-pixel tile, then reflect
     515   00:423A                              ; only the horizontal velocity. NegateAndDamp retains 75% energy.
