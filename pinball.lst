    2114   00:4C4E                      
    2115   00:4C4E                      ; Run in VBlank. XOR the normal/hit delta once to show the hit frame, hold it
    2116   00:4C4E                      ; for eight frames, then XOR the same pixels again to restore the original.
    2117   00:4C4E                      UpdateObjectAnimation:
    2118   00:4C4E                              ; Timer bit 7 means "not drawn yet". This defers the VDP command from
    2119   00:4C4E                              ; the middle of physics to the next VBlank-safe video update.
    2120   00:4C4E  3A 22 C0                    ld      a,(OBJECT_ANIM_TIMER)
    2121   00:4C51  B7                          or      a
    2122   00:4C52  C8                          ret     z
