      43   00:4000  (00:00D5)           GTSTCK: equ     00d5h
      44   00:4000  (00:00D8)           GTTRIG: equ     00d8h
      45   00:4000  (00:005C)           LDIRVM: equ     005ch
      46   00:4000  (00:0047)           WRTVDP: equ     0047h
      47   00:4000  (00:F3E0)           RG1SAV: equ     0f3e0h
      48   00:4000                      
      49   00:4000                      ; VRAM layout used by the two overlapping ball sprites.
      50   00:4000  (00:7400)           SPRITE_COLORS:  equ 7400h
      51   00:4000  (00:7600)           SPRITE_ATTR:    equ 7600h
      52   00:4000  (00:7800)           SPRITE_PATTERNS:equ 7800h
      53   00:4000                      
      54   00:4000                      ; Safety limits. The authored tilemap is authoritative; these only stop a ball
      55   00:4000                      ; escaping if a malformed map contains an unintended opening.
      56   00:4000  (00:0000)           LEFT_WALL:      equ 0               ; emergency bounds outside the tile walls
      57   00:4000  (00:00F0)           RIGHT_WALL:     equ 240
      58   00:4000  (00:0000)           TOP_WALL:       equ 0
      59   00:4000  (00:00CC)           DRAIN_Y:        equ 204
      60   00:4000                      
      61   00:4000                      ; Physics tuning. Values are signed 8.8 pixels per simulation frame.
      62   00:4000  (00:0018)           GRAVITY:        equ 0018h           ; +0.09375 velocity per full-speed frame
      63   00:4000  (00:0018)           PHYSICS_GRAVITY:equ GRAVITY         ; full acceleration per display frame
      64   00:4000  (00:0500)           MAX_FALL_SPEED: equ 0500h           ; +5 pixels/frame
      65   00:4000  (00:FEC0)           LAUNCH_VX:      equ 0fec0h          ; -1.25 pixels/frame, clearly toward left
      66   00:4000  (00:F900)           LAUNCH_VY:      equ 0f900h          ; -7 pixels/frame, reaches the top arc
      67   00:4000  (00:FD00)           FLIPPER_BASE_VY:equ 0fd00h          ; -3 pixels/frame near the pivot
      68   00:4000  (00:FC00)           FLIPPER_MID_VY: equ 0fc00h          ; -4 pixels/frame halfway out
      69   00:4000  (00:FB00)           FLIPPER_TIP_VY: equ 0fb00h          ; -5 pixels/frame at the tip
      70   00:4000  (00:0200)           TUBE_EXIT_VX:   equ 0200h           ; +2 pixels/frame
      71   00:4000  (00:FE80)           TUBE_EXIT_VY:   equ 0fe80h          ; -1.5 pixels/frame
      72   00:4000                      ; Writable state in RAM. Keeping variables at fixed addresses makes them easy
      73   00:4000                      ; to inspect from openMSX's debugger and from the automated Tcl smoke tests.
      74   00:4000  (00:C000)           BALL_X:         equ 0c000h           ; word, 8.8 fixed point
      75   00:4000  (00:C002)           BALL_Y:         equ 0c002h           ; word, 8.8 fixed point
      76   00:4000  (00:C004)           BALL_VX:        equ 0c004h           ; word, signed 8.8
      77   00:4000  (00:C006)           BALL_VY:        equ 0c006h           ; word, signed 8.8
      78   00:4000  (00:C008)           BALL_WAITING:   equ 0c008h           ; 1 while parked in the launch lane
      79   00:4000  (00:C009)           BUMPER_LOCK:    equ 0c009h           ; short global anti-double-trigger timer
      80   00:4000  (00:C00A)           LEFT_ACTIVE:    equ 0c00ah           ; current input state, 0 or 1
      81   00:4000  (00:C00B)           RIGHT_ACTIVE:   equ 0c00bh
      82   00:4000  (00:C00C)           BALL_SIDE:      equ 0c00ch           ; temporary contact id: normal 0..7 or flipper 1..4
      83   00:4000  (00:C00D)           BALL_IN_TUBE:   equ 0c00dh           ; covered tube owns movement while nonzero
      84   00:4000  (00:C00E)           TUBE_INDEX:     equ 0c00eh           ; byte offset into TubePath
      85   00:4000  (00:C00F)           BALL_HIT_X:     equ 0c00fh           ; signed centre-to-object delta
      86   00:4000  (00:C010)           BALL_HIT_Y:     equ 0c010h
      87   00:4000  (00:C011)           LEFT_FRAME:     equ 0c011h           ; 0=rest, 1=middle, 2=raised
      88   00:4000  (00:C012)           RIGHT_FRAME:    equ 0c012h
      89   00:4000  (00:C013)           BALL_FRAME:     equ 0c013h           ; 0=top, clockwise through 7=top-left
      90   00:4000  (00:C014)           BALL_ROLL_ACCUM:equ 0c014h           ; word, accumulated horizontal distance
      91   00:4000  (00:C016)           LEFT_KICK:      equ 0c016h           ; nonzero only while flipper moves upward
      92   00:4000  (00:C017)           RIGHT_KICK:     equ 0c017h
      93   00:4000  (00:C018)           OBJECT_RADIUS:  equ 0c018h           ; expanded object+ball collision radius
      94   00:4000  (00:C019)           OBJECT_RADIUS_SQ:equ 0c019h          ; word
      95   00:4000  (00:C01B)           LAST_BUMPER_PTR:equ 0c01bh           ; last actively fired object record
      96   00:4000  (00:C01D)           ABS_HIT_X:      equ 0c01dh
      97   00:4000  (00:C01E)           ABS_HIT_Y:      equ 0c01eh
      98   00:4000  (00:C01F)           LAST_BUMPER_KIND:equ 0c01fh          ; 0=none, 1=circle, 2=polygon field
      99   00:4000  (00:C020)           POLY_LOCAL_X:   equ 0c020h           ; scratch X inside a compiled polygon field
     100   00:4000  (00:C021)           POLY_FIELD_VALUE:equ 0c021h          ; scratch nibble/normal selector
     101   00:4000  (00:C022)           OBJECT_ANIM_TIMER:equ 0c022h         ; bit 7=pending draw, low bits=hold frames
     102   00:4000  (00:C023)           OBJECT_ANIM_SOURCE_X:equ 0c023h       ; XOR-delta frame in hidden VRAM atlas
