     906   00:4491                      ; IX points at a polygon record:
     907   00:4491                      ;   +0 size low, +1 size high, +2 type
     908   00:4491                      ;   +3 field X, +4 field Y, +5 width, +6 height
     909   00:4491                      ;   +7 kick, +8/+9 score, +10 animation-atlas X
     910   00:4491                      ;   +11... packed collision nibbles in row-major order
     911   00:4491                      ; Return carry set and A=field byte when the ball centre lies inside the field.
     912   00:4491                      LookupPolygonField:
     913   00:4491  3A 01 C0                    ld      a,(BALL_X+1)
     914   00:4494  C6 08                       add     a,8
     915   00:4496  DD 96 03                    sub     (ix+3)
