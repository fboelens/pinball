     920   00:44A3                      
     921   00:44A3  3A 03 C0                    ld      a,(BALL_Y+1)
     922   00:44A6  C6 08                       add     a,8
     923   00:44A8  DD 96 04                    sub     (ix+4)
     924   00:44AB  38 40                       jr      c,.outside
     925   00:44AD  DD BE 06                    cp      (ix+6)
     926   00:44B0  30 3B                       jr      nc,.outside
     927   00:44B2  4F                          ld      c,a                   ; local Y
     928   00:44B3  DD 5E 05                    ld      e,(ix+5)              ; row width
     929   00:44B6  16 00                       ld      d,0
     930   00:44B8  21 00 00                    ld      hl,0
     931   00:44BB  79                          ld      a,c
     932   00:44BC  B7                          or      a
     933   00:44BD  28 04                       jr      z,.rowReady
     934   00:44BF                      .rowLoop:
     935   00:44BF  19                          add     hl,de
     936   00:44C0  3D                          dec     a
     937   00:44C1  20 FC                       jr      nz,.rowLoop
     938   00:44C3                      .rowReady:
     939   00:44C3                              ; Linear pixel index = localY*width + localX. Division by two selects
     940   00:44C3                              ; the packed byte; index bit zero selects its low or high nibble.
     941   00:44C3  3A 20 C0                    ld      a,(POLY_LOCAL_X)
     942   00:44C6  5F                          ld      e,a
     943   00:44C7  16 00                       ld      d,0
     944   00:44C9  19                          add     hl,de
     945   00:44CA  7D                          ld      a,l
     946   00:44CB  E6 01                       and     1
     947   00:44CD  32 21 C0                    ld      (POLY_FIELD_VALUE),a  ; select low/even or high/odd nibble
     948   00:44D0  CB 3C                       srl     h
     949   00:44D2  CB 1D                       rr      l
     950   00:44D4  DD E5                       push    ix
     951   00:44D6  D1                          pop     de
     952   00:44D7  19                          add     hl,de
     953   00:44D8  11 0B 00                    ld      de,11
     954   00:44DB  19                          add     hl,de
     955   00:44DC  7E                          ld      a,(hl)
     956   00:44DD  4F                          ld      c,a
     957   00:44DE  3A 21 C0                    ld      a,(POLY_FIELD_VALUE)
     958   00:44E1  B7                          or      a
     959   00:44E2  79                          ld      a,c
     960   00:44E3  28 04                       jr      z,.lowNibble
