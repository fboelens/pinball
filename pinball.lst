    2093   00:4C33                      ; Queue one 16x16 object flash. A is the delta frame's X in the hidden atlas,
    2094   00:4C33                      ; B/C are its playfield destination. Ignore another hit until this brief flash
    2095   00:4C33                      ; has restored the first object, preventing abandoned highlighted graphics.
    2096   00:4C33                      QueueObjectAnimation:
    2097   00:4C33                              ; The build tool stores XOR differences, not complete frames. Source X
    2098   00:4C33                              ; therefore identifies one 16x16 delta in hidden scanlines 212..227.
    2099   00:4C33  FE FF                       cp      0ffh
    2100   00:4C35  C8                          ret     z
    2101   00:4C36  57                          ld      d,a
    2102   00:4C37  3A 22 C0                    ld      a,(OBJECT_ANIM_TIMER)
