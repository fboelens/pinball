     518   00:423D  D6 10                       sub     16
     519   00:423F  67                          ld      h,a
     520   00:4240  2E 00                       ld      l,0
     521   00:4242  22 00 C0                    ld      (BALL_X),hl
     522   00:4245  2A 04 C0                    ld      hl,(BALL_VX)
     523   00:4248  CD D0 43                    call    NegateAndDamp
