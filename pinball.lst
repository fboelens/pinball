    2458   00:4E47                      ; HL points to SX,SY,DX,DY,NX,NY (words), colour, ARG and LMMM-XOR command.
    2459   00:4E47                      VDP_LMMM_XOR:
    2460   00:4E47                              ; LMMM performs a logical pixel copy. XORing normal^hit over the normal
    2461   00:4E47                              ; image produces hit; applying the identical command again restores it.
    2462   00:4E47  CD 5D 4E                    call    WaitVDPCommand
    2463   00:4E4A  01 99 8F                    ld      bc,(15+128)*256+099h
    2464   00:4E4D  11 20 91                    ld      de,(17+128)*256+32
    2465   00:4E50  F3                          di
    2466   00:4E51  ED 59                       out     (c),e                ; indirect writes start at VDP R#32
    2467   00:4E53  ED 51                       out     (c),d
    2468   00:4E55  0E 9B                       ld      c,09bh
    2469   00:4E57  06 0F                       ld      b,15
    2470   00:4E59  ED B3                       otir                         ; R#32 through R#46, command last
    2471   00:4E5B  FB                          ei
