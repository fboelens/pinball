    1545   00:48A2  5F                          ld      e,a
    1546   00:48A3  16 00                       ld      d,0
    1547   00:48A5  21 AF 48                    ld      hl,SquareTable
    1548   00:48A8  19                          add     hl,de
    1549   00:48A9  5E                          ld      e,(hl)
    1550   00:48AA  23                          inc     hl
    1551   00:48AB  56                          ld      d,(hl)
    1552   00:48AC  EB                          ex      de,hl
    1553   00:48AD  D1                          pop     de
    1554   00:48AE  C9                          ret
    1555   00:48AF                      
    1556   00:48AF                      SquareTable:
    1557   00:48AF                              dw      0,1,4,9,16,25,36,49,64,81
    1557   00:48AF  00 00 01 00 04 00 09 00 10 00 19 00 24 00 31 00 
    1557   00:48BF  40 00 51 00 
    1558   00:48C3                              dw      100,121,144,169,196,225,256,289,324,361
    1558   00:48C3  64 00 79 00 90 00 A9 00 C4 00 E1 00 00 01 21 01 
    1558   00:48D3  44 01 69 01 
    1559   00:48D7                      
    1560   00:48D7                      ; -----------------------------------------------------------------------------
    1561   00:48D7                      ; Flipper collisions
    1562   00:48D7                      ; -----------------------------------------------------------------------------
    1563   00:48D7                      ;
    1564   00:48D7                      ; maps/flippers.tmx supplies one convex polygon for every left/right animation
    1565   00:48D7                      ; frame. The build expands each polygon by the ball radius and compiles it into
    1566   00:48D7                      ; a packed per-pixel normal field, so runtime collision is just one lookup.
    1567   00:48D7                      ; Fields are pivot-relative and therefore reusable at another table position.
    1568   00:48D7                      ; Flipper collision changes velocity only; it never rewrites BALL_X/BALL_Y.
    1569   00:48D7                      CheckFlippers:
    1570   00:48D7  3A 13 51                    ld      a,(FlipperInstances)
    1571   00:48DA  B7                          or      a
    1572   00:48DB  C8                          ret     z
    1573   00:48DC  47                          ld      b,a
    1574   00:48DD  FD 21 14 51                 ld      iy,FlipperInstances+1
    1575   00:48E1                      .loop:
    1576   00:48E1  C5                          push    bc
    1577   00:48E2  CD 99 49                    call    GetInstanceFrame
    1578   00:48E5  32 2C C0                    ld      (FLIPPER_NORMAL+1),a  ; temporary current frame, overwritten later
    1579   00:48E8  4F                          ld      c,a
    1580   00:48E9  FD 7E 00                    ld      a,(iy+0)             ; visual/collision side: 0 left, 1 right
    1581   00:48EC  B7                          or      a
    1582   00:48ED  79                          ld      a,c
    1583   00:48EE  28 02                       jr      z,.fieldReady
    1584   00:48F0  C6 03                       add     a,3                  ; right fields occupy header slots 3..5
    1585   00:48F2                      .fieldReady:
    1586   00:48F2  CD AF 4A                    call    LoadFlipperCollisionField
    1587   00:48F5  FD 7E 02                    ld      a,(iy+2)
    1588   00:48F8  32 2F C0                    ld      (FLIPPER_PIVOT_X),a
    1589   00:48FB  FD 7E 03                    ld      a,(iy+3)
    1590   00:48FE  32 2E C0                    ld      (FLIPPER_PIVOT_Y),a
    1591   00:4901  CD C2 4A                    call    LookupFlipperCollisionField
    1592   00:4904  D2 8E 49                    jp      nc,.next
    1593   00:4907  E6 0F                       and     00fh
    1594   00:4909  CA 8E 49                    jp      z,.next
    1595   00:490C  3D                          dec     a
    1596   00:490D  32 0C C0                    ld      (BALL_SIDE),a
    1597   00:4910  CD 2E 4B                    call    MeasureFlipperDistance
    1598   00:4913  CD A5 49                    call    GetInstanceKick
    1599   00:4916  B7                          or      a
    1600   00:4917  20 30                       jr      nz,.activeHit
    1601   00:4919                      
    1602   00:4919                              ; Normal 6 is the long upper blade edge. It uses slope-aware rolling;
    1603   00:4919                              ; cap, underside and polygon corners use their generated normal directly.
    1604   00:4919  3A 0C C0                    ld      a,(BALL_SIDE)
    1605   00:491C  FE 06                       cp      6
    1606   00:491E  20 24                       jr      nz,.genericPassive
    1607   00:4920  FD 7E 00                    ld      a,(iy+0)
    1608   00:4923  B7                          or      a
    1609   00:4924  20 0C                       jr      nz,.rightBlade
    1610   00:4926  3A 2C C0                    ld      a,(FLIPPER_NORMAL+1)
    1611   00:4929  B7                          or      a
    1612   00:492A  3E 03                       ld      a,3                  ; resting left: downhill right
    1613   00:492C  28 0E                       jr      z,.bladeReady
    1614   00:492E  3E 01                       ld      a,1                  ; raised left: downhill toward left pivot
    1615   00:4930  18 0A                       jr      .bladeReady
    1616   00:4932                      .rightBlade:
    1617   00:4932  3A 2C C0                    ld      a,(FLIPPER_NORMAL+1)
    1618   00:4935  B7                          or      a
    1619   00:4936  3E 04                       ld      a,4                  ; resting right: downhill left
    1620   00:4938  28 02                       jr      z,.bladeReady
    1621   00:493A  3E 02                       ld      a,2                  ; raised right: downhill toward right pivot
    1622   00:493C                      .bladeReady:
    1623   00:493C  32 0C C0                    ld      (BALL_SIDE),a
    1624   00:493F  CD B1 49                    call    PassiveFlipperHit
    1625   00:4942  C1                          pop     bc
    1626   00:4943  C9                          ret
    1627   00:4944                      .genericPassive:
    1628   00:4944  CD 43 47                    call    PassiveCircleResponse
    1629   00:4947  C1                          pop     bc
    1630   00:4948  C9                          ret
    1631   00:4949                      
    1632   00:4949                      .activeHit:
    1633   00:4949                              ; Close to the axle the horizontal component points outward; farther
    1634   00:4949                              ; along the blade it points inward. The generated base threshold makes
    1635   00:4949                              ; this decision independent of the flipper's world position.
    1636   00:4949  3A 2D C0                    ld      a,(FLIPPER_DISTANCE)
    1637   00:494C  DD BE 04                    cp      (ix+4)
    1638   00:494F  30 0E                       jr      nc,.inwardKick
    1639   00:4951  FD 7E 00                    ld      a,(iy+0)
    1640   00:4954  B7                          or      a
    1641   00:4955  21 C0 FE                    ld      hl,0fec0h            ; left base pushes left
    1642   00:4958  28 11                       jr      z,.storeKickX
    1643   00:495A  21 40 01                    ld      hl,0140h             ; right base pushes right
    1644   00:495D  18 0C                       jr      .storeKickX
    1645   00:495F                      .inwardKick:
    1646   00:495F  FD 7E 00                    ld      a,(iy+0)
    1647   00:4962  B7                          or      a
    1648   00:4963  21 40 01                    ld      hl,0140h             ; left blade points inward/right
    1649   00:4966  28 03                       jr      z,.storeKickX
    1650   00:4968  21 C0 FE                    ld      hl,0fec0h            ; right blade points inward/left
    1651   00:496B                      .storeKickX:
    1652   00:496B  22 04 C0                    ld      (BALL_VX),hl
    1653   00:496E  3A 2D C0                    ld      a,(FLIPPER_DISTANCE)
    1654   00:4971  DD BE 04                    cp      (ix+4)
    1655   00:4974  21 00 FD                    ld      hl,FLIPPER_BASE_VY
    1656   00:4977  38 0B                       jr      c,.storeKick
    1657   00:4979  DD BE 05                    cp      (ix+5)
    1658   00:497C  21 00 FC                    ld      hl,FLIPPER_MID_VY
    1659   00:497F  38 03                       jr      c,.storeKick
    1660   00:4981  21 00 FB                    ld      hl,FLIPPER_TIP_VY
    1661   00:4984                      .storeKick:
    1662   00:4984  22 06 C0                    ld      (BALL_VY),hl
    1663   00:4987  3E 05                       ld      a,5
    1664   00:4989  32 09 C0                    ld      (BUMPER_LOCK),a
    1665   00:498C  C1                          pop     bc
    1666   00:498D  C9                          ret
    1667   00:498E                      .next:
    1668   00:498E  C1                          pop     bc
    1669   00:498F  11 08 00                    ld      de,8
    1670   00:4992  FD 19                       add     iy,de
    1671   00:4994  05                          dec     b
    1672   00:4995  C2 E1 48                    jp      nz,.loop
    1673   00:4998  C9                          ret
    1674   00:4999                      
    1675   00:4999                      ; Map instance control 0 uses the left state; control 1 uses the right state.
    1676   00:4999                      GetInstanceFrame:
    1677   00:4999  FD 7E 01                    ld      a,(iy+1)
    1678   00:499C  B7                          or      a
    1679   00:499D  3A 11 C0                    ld      a,(LEFT_FRAME)
    1680   00:49A0  C8                          ret     z
    1681   00:49A1  3A 12 C0                    ld      a,(RIGHT_FRAME)
    1682   00:49A4  C9                          ret
    1683   00:49A5                      
    1684   00:49A5                      GetInstanceKick:
    1685   00:49A5  FD 7E 01                    ld      a,(iy+1)
    1686   00:49A8  B7                          or      a
    1687   00:49A9  3A 16 C0                    ld      a,(LEFT_KICK)
    1688   00:49AC  C8                          ret     z
    1689   00:49AD  3A 17 C0                    ld      a,(RIGHT_KICK)
    1690   00:49B0  C9                          ret
    1691   00:49B1                      
    1692   00:49B1                      ; Collision with a stationary flipper. The former circular collision samples
    1693   00:49B1                      ; are gone; this response remains only for the polygon's long upper blade edge:
    1694   00:49B1                      ; roughly 8 horizontal pixels for every 3 vertical pixels. This avoids treating
    1695   00:49B1                      ; the flipper as a sticky horizontal shelf.
    1696   00:49B1                      PassiveFlipperHit:
    1697   00:49B1  2A 04 C0                    ld      hl,(BALL_VX)
    1698   00:49B4  22 27 C0                    ld      (FLIPPER_OLD_VX),hl
    1699   00:49B7  2A 06 C0                    ld      hl,(BALL_VY)
    1700   00:49BA  22 29 C0                    ld      (FLIPPER_OLD_VY),hl
    1701   00:49BD                      
    1702   00:49BD                              ; Normal approach speed is 8*VY-3*VX for a \ slope and 8*VY+3*VX
    1703   00:49BD                              ; for a / slope. If it is zero or negative, the ball already travels
    1704   00:49BD                              ; away from the surface; responding again would cause contact jitter.
    1705   00:49BD  29                          add     hl,hl
    1706   00:49BE  29                          add     hl,hl
    1707   00:49BF  29                          add     hl,hl                 ; HL = 8*VY
    1708   00:49C0  EB                          ex      de,hl
    1709   00:49C1  2A 27 C0                    ld      hl,(FLIPPER_OLD_VX)
    1710   00:49C4  44                          ld      b,h
    1711   00:49C5  4D                          ld      c,l
    1712   00:49C6  29                          add     hl,hl
    1713   00:49C7  09                          add     hl,bc                 ; HL = 3*VX
    1714   00:49C8  3A 0C C0                    ld      a,(BALL_SIDE)
    1715   00:49CB  FE 02                       cp      2
    1716   00:49CD  28 08                       jr      z,.positiveSlope
    1717   00:49CF  FE 03                       cp      3
    1718   00:49D1  28 04                       jr      z,.positiveSlope
    1719   00:49D3  EB                          ex      de,hl
    1720   00:49D4  19                          add     hl,de                 ; / slope: 8*VY + 3*VX
    1721   00:49D5  18 04                       jr      .normalReady
    1722   00:49D7                      .positiveSlope:
    1723   00:49D7  EB                          ex      de,hl
    1724   00:49D8  B7                          or      a
    1725   00:49D9  ED 52                       sbc     hl,de                 ; \ slope: 8*VY - 3*VX
    1726   00:49DB                      .normalReady:
    1727   00:49DB  22 2B C0                    ld      (FLIPPER_NORMAL),hl
    1728   00:49DE  CB 7C                       bit     7,h
    1729   00:49E0  C0                          ret     nz
    1730   00:49E1  7C                          ld      a,h
    1731   00:49E2  B5                          or      l
    1732   00:49E3  C8                          ret     z
    1733   00:49E4  7C                          ld      a,h
    1734   00:49E5  FE 04                       cp      4                    ; small normal speed is resting contact
    1735   00:49E7  DA 21 4A                    jp      c,PassiveFlipperRoll
    1736   00:49EA                      
    1737   00:49EA                              ; Tangential velocity loses very little energy. In this inexpensive
    1738   00:49EA                              ; fixed-point approximation:
    1739   00:49EA                              ;   VX' = 7/8*VX +/- 3/8*VY
    1740   00:49EA                              ; The sign mirrors with the flipper slope.
    1741   00:49EA  2A 27 C0                    ld      hl,(FLIPPER_OLD_VX)
    1742   00:49ED  CD 73 4A                    call    DampHLSevenEighths
    1743   00:49F0  E5                          push    hl
    1744   00:49F1  2A 29 C0                    ld      hl,(FLIPPER_OLD_VY)
    1745   00:49F4  CD 88 4A                    call    ScaleHLThreeEighths
    1746   00:49F7  CD 67 4A                    call    NegateForNegativeFlipperSlope
    1747   00:49FA  EB                          ex      de,hl
    1748   00:49FB  E1                          pop     hl
    1749   00:49FC  19                          add     hl,de
    1750   00:49FD  22 04 C0                    ld      (BALL_VX),hl
    1751   00:4A00                      
    1752   00:4A00                              ; A hard impact returns about 1/4 of the normal component:
    1753   00:4A00                              ;   VY' = +/-3/8*VX - 1/8*VY
    1754   00:4A00  2A 27 C0                    ld      hl,(FLIPPER_OLD_VX)
    1755   00:4A03  CD 88 4A                    call    ScaleHLThreeEighths
    1756   00:4A06  CD 67 4A                    call    NegateForNegativeFlipperSlope
    1757   00:4A09  EB                          ex      de,hl
    1758   00:4A0A  2A 29 C0                    ld      hl,(FLIPPER_OLD_VY)
    1759   00:4A0D  CB 2C                       sra     h
    1760   00:4A0F  CB 1D                       rr      l
    1761   00:4A11  CB 2C                       sra     h
    1762   00:4A13  CB 1D                       rr      l
    1763   00:4A15  CB 2C                       sra     h
    1764   00:4A17  CB 1D                       rr      l                    ; HL = 1/8*old VY
    1765   00:4A19  CD 93 48                    call    NegateHL
    1766   00:4A1C  19                          add     hl,de
    1767   00:4A1D  22 06 C0                    ld      (BALL_VY),hl
    1768   00:4A20  C9                          ret
    1769   00:4A21                      
    1770   00:4A21                      ; A gentle contact is a support constraint, not a bounce and not glue. Project
    1771   00:4A21                      ; velocity onto the blade tangent with coefficients close to the 8:3 slope.
    1772   00:4A21                      ; Sixteenth-based fractions deliberately keep more useful low bits than a more
    1773   00:4A21                      ; exact /64 approximation would on this 8.8 fixed-point Z80 simulation.
    1774   00:4A21                      PassiveFlipperRoll:
    1775   00:4A21  2A 27 C0                    ld      hl,(FLIPPER_OLD_VX)
    1776   00:4A24  CD 73 4A                    call    DampHLSevenEighths
    1777   00:4A27  E5                          push    hl
    1778   00:4A28  2A 29 C0                    ld      hl,(FLIPPER_OLD_VY)
    1779   00:4A2B  CD 99 4A                    call    ScaleHLFiveSixteenths
    1780   00:4A2E  CD 67 4A                    call    NegateForNegativeFlipperSlope
    1781   00:4A31  EB                          ex      de,hl
    1782   00:4A32  E1                          pop     hl
    1783   00:4A33  19                          add     hl,de
    1784   00:4A34                              ; This +/-3/256 impulse is gravity projected along the blade. It is an
    1785   00:4A34                              ; acceleration rather than a minimum/fixed roll speed, so momentum is
    1786   00:4A34                              ; preserved and the ball naturally gathers speed while descending.
    1787   00:4A34  3A 0C C0                    ld      a,(BALL_SIDE)
    1788   00:4A37  FE 02                       cp      2
    1789   00:4A39  11 03 00                    ld      de,0003h
    1790   00:4A3C  28 07                       jr      z,.addRollGravity
    1791   00:4A3E  FE 03                       cp      3
    1792   00:4A40  28 03                       jr      z,.addRollGravity
    1793   00:4A42  11 FD FF                    ld      de,0fffdh
    1794   00:4A45                      .addRollGravity:
    1795   00:4A45  19                          add     hl,de
    1796   00:4A46  22 04 C0                    ld      (BALL_VX),hl
    1797   00:4A49                      
    1798   00:4A49  2A 27 C0                    ld      hl,(FLIPPER_OLD_VX)
    1799   00:4A4C  CD 99 4A                    call    ScaleHLFiveSixteenths
    1800   00:4A4F  CD 67 4A                    call    NegateForNegativeFlipperSlope
    1801   00:4A52  EB                          ex      de,hl
    1802   00:4A53  2A 29 C0                    ld      hl,(FLIPPER_OLD_VY)
    1803   00:4A56  CB 2C                       sra     h
    1804   00:4A58  CB 1D                       rr      l
    1805   00:4A5A  CB 2C                       sra     h
    1806   00:4A5C  CB 1D                       rr      l
    1807   00:4A5E  CB 2C                       sra     h
    1808   00:4A60  CB 1D                       rr      l                    ; +1/8*old VY: no restitution at rest
    1809   00:4A62  19                          add     hl,de
    1810   00:4A63  22 06 C0                    ld      (BALL_VY),hl
    1811   00:4A66  C9                          ret
    1812   00:4A67                      
    1813   00:4A67                      ; Side ids 2 (held right) and 3 (resting left) use a positive transfer term.
    1814   00:4A67                      ; Sides 1 and 4 are their exact mirrors and therefore negate that term.
    1815   00:4A67                      NegateForNegativeFlipperSlope:
    1816   00:4A67  3A 0C C0                    ld      a,(BALL_SIDE)
    1817   00:4A6A  FE 02                       cp      2
    1818   00:4A6C  C8                          ret     z
    1819   00:4A6D  FE 03                       cp      3
    1820   00:4A6F  C8                          ret     z
    1821   00:4A70  C3 93 48                    jp      NegateHL
    1822   00:4A73                      
    1823   00:4A73                      ; Return HL = HL * 7/8 while preserving its sign. This is deliberately much
    1824   00:4A73                      ; less friction than the 3/4 damping used for a direct wall rebound.
    1825   00:4A73                      DampHLSevenEighths:
    1826   00:4A73  44                          ld      b,h
    1827   00:4A74  4D                          ld      c,l
    1828   00:4A75  CB 2C                       sra     h
    1829   00:4A77  CB 1D                       rr      l
    1830   00:4A79  CB 2C                       sra     h
    1831   00:4A7B  CB 1D                       rr      l
    1832   00:4A7D  CB 2C                       sra     h
    1833   00:4A7F  CB 1D                       rr      l                   ; HL = original / 8
    1834   00:4A81  EB                          ex      de,hl
    1835   00:4A82  60                          ld      h,b
    1836   00:4A83  69                          ld      l,c
    1837   00:4A84  B7                          or      a
    1838   00:4A85  ED 52                       sbc     hl,de               ; original - original/8
    1839   00:4A87  C9                          ret
    1840   00:4A88                      
    1841   00:4A88                      ; Return HL = HL * 3/8 using signed arithmetic shifts. Flipper response uses
    1842   00:4A88                      ; this for the small amount of velocity transferred across its diagonal slope.
    1843   00:4A88                      ScaleHLThreeEighths:
    1844   00:4A88  CB 2C                       sra     h
    1845   00:4A8A  CB 1D                       rr      l
    1846   00:4A8C  CB 2C                       sra     h
    1847   00:4A8E  CB 1D                       rr      l
    1848   00:4A90  CB 2C                       sra     h
    1849   00:4A92  CB 1D                       rr      l                    ; HL = original / 8
    1850   00:4A94  54                          ld      d,h
    1851   00:4A95  5D                          ld      e,l
    1852   00:4A96  29                          add     hl,hl                ; original / 4
    1853   00:4A97  19                          add     hl,de                ; original * 3/8
    1854   00:4A98  C9                          ret
    1855   00:4A99                      
    1856   00:4A99                      ; Return HL = HL * 5/16. This is slightly below the exact cross coefficient of
    1857   00:4A99                      ; an 8:3 slope, ensuring contacts are stable while retaining precision at crawl
    1858   00:4A99                      ; speeds (where a six-bit right shift would quantise the result to zero).
    1859   00:4A99                      ScaleHLFiveSixteenths:
    1860   00:4A99  CB 2C                       sra     h
    1861   00:4A9B  CB 1D                       rr      l
    1862   00:4A9D  CB 2C                       sra     h
    1863   00:4A9F  CB 1D                       rr      l
    1864   00:4AA1  CB 2C                       sra     h
    1865   00:4AA3  CB 1D                       rr      l
    1866   00:4AA5  CB 2C                       sra     h
    1867   00:4AA7  CB 1D                       rr      l                    ; HL = original / 16
    1868   00:4AA9  54                          ld      d,h
    1869   00:4AAA  5D                          ld      e,l
    1870   00:4AAB  29                          add     hl,hl                ; 2/16
    1871   00:4AAC  29                          add     hl,hl                ; 4/16
    1872   00:4AAD  19                          add     hl,de                ; 5/16
    1873   00:4AAE  C9                          ret
    1874   00:4AAF                      
    1875   00:4AAF                      ; Select one of the six generated records. A is 0..2 for left frames and 3..5
    1876   00:4AAF                      ; for right frames. The binary header contains six offsets relative to its base.
    1877   00:4AAF                      LoadFlipperCollisionField:
    1878   00:4AAF  87                          add     a,a
    1879   00:4AB0  5F                          ld      e,a
    1880   00:4AB1  16 00                       ld      d,0
    1881   00:4AB3  21 EB 5E                    ld      hl,FlipperCollisionData
    1882   00:4AB6  19                          add     hl,de
    1883   00:4AB7  5E                          ld      e,(hl)
    1884   00:4AB8  23                          inc     hl
    1885   00:4AB9  56                          ld      d,(hl)
    1886   00:4ABA  21 EB 5E                    ld      hl,FlipperCollisionData
    1887   00:4ABD  19                          add     hl,de
    1888   00:4ABE  E5                          push    hl
    1889   00:4ABF  DD E1                       pop     ix
    1890   00:4AC1  C9                          ret
    1891   00:4AC2                      
    1892   00:4AC2                      ; Record layout:
    1893   00:4AC2                      ;   +0/+1 signed field origin relative to pivot, +2 width, +3 height
    1894   00:4AC2                      ;   +4 base distance limit, +5 tip distance start, +6 packed normal field
    1895   00:4AC2                      ; Return carry set and A=normal+1 when the current ball centre is in the field.
    1896   00:4AC2                      LookupFlipperCollisionField:
    1897   00:4AC2  DD 7E 00                    ld      a,(ix+0)
    1898   00:4AC5  4F                          ld      c,a
    1899   00:4AC6  3A 2F C0                    ld      a,(FLIPPER_PIVOT_X)
    1900   00:4AC9  81                          add     a,c                   ; absolute field origin X
    1901   00:4ACA  4F                          ld      c,a
