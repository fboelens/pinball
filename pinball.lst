    2474   00:4E5D                      WaitVDPCommand:
    2475   00:4E5D                              ; Status register 2 bit CE is one while a command-engine operation runs.
    2476   00:4E5D                              ; Restore status-register selection to zero before returning to BIOS.
    2477   00:4E5D                      .wait:
    2478   00:4E5D  01 99 8F                    ld      bc,(15+128)*256+099h
    2479   00:4E60  11 02 00                    ld      de,2                 ; select status register 2
    2480   00:4E63  F3                          di
    2481   00:4E64  ED 59                       out     (c),e
    2482   00:4E66  ED 41                       out     (c),b
    2483   00:4E68  DB 99                       in      a,(099h)
    2484   00:4E6A  1F                          rra                          ; CE flag -> carry
    2485   00:4E6B  3E 00                       ld      a,0                  ; select status register 0 again
    2486   00:4E6D  ED 79                       out     (c),a
    2487   00:4E6F  ED 41                       out     (c),b
    2488   00:4E71  FB                          ei
    2489   00:4E72  38 E9                       jr      c,.wait
