     649   00:431A  7A                          ld      a,d
     650   00:431B  28 03                       jr      z,.surfaceReady
     651   00:431D  3E 07                       ld      a,7
     652   00:431F  92                          sub     d                    ; '/' height = 7-localX
     653   00:4320                      .surfaceReady:
