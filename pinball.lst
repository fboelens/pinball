    2190   00:4CC9                      ; Expand each compressed half through the reusable 16 KiB RAM window and copy
    2191   00:4CC9                      ; it to VRAM. Both source streams stay below CPU address 8000h.
    2192   00:4CC9                      UploadPlayfield:
    2193   00:4CC9                              ; Page 2 (8000h-BFFFh) is RAM in this cartridge setup. It is a temporary
    2194   00:4CC9                              ; buffer only: both compressed streams and live collision data remain
    2195   00:4CC9                              ; directly readable below 8000h in the ROM page.
    2196   00:4CC9  21 66 74                    ld      hl,PlayfieldBank0
    2197   00:4CCC  11 00 80                    ld      de,08000h
