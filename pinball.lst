     999   00:4519  C6 08                       add     a,8
    1000   00:451B  4F                          ld      c,a
    1001   00:451C  DD 7E 04                    ld      a,(ix+4)
    1002   00:451F  D6 04                       sub     4
    1003   00:4521  57                          ld      d,a
    1004   00:4522  79                          ld      a,c
