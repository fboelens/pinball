     346   00:4139                      ; Ball simulation
     347   00:4139                      ; -----------------------------------------------------------------------------
     348   00:4139                      
     349   00:4139                      StepBall:
     350   00:4139                              ; The covered tube is a scripted path, so it bypasses gravity and all
     351   00:4139                              ; normal collision code. It advances one path node every display frame.
     352   00:4139  3A 0D C0                    ld      a,(BALL_IN_TUBE)
     353   00:413C  B7                          or      a
     354   00:413D  28 03                       jr      z,.notInTube
     355   00:413F  C3 73 4B                    jp      StepTube
     356   00:4142                      .notInTube:
     357   00:4142                      
     358   00:4142  3A 08 C0                    ld      a,(BALL_WAITING)
     359   00:4145  B7                          or      a
     360   00:4146  28 1A                       jr      z,.moving
     361   00:4148                      
     362   00:4148                              ; Any flipper/trigger input launches the ball from the right lane.
     363   00:4148  3A 0A C0                    ld      a,(LEFT_ACTIVE)
     364   00:414B  4F                          ld      c,a
     365   00:414C  3A 0B C0                    ld      a,(RIGHT_ACTIVE)
     366   00:414F  B1                          or      c
     367   00:4150  C8                          ret     z
     368   00:4151  AF                          xor     a
     369   00:4152  32 08 C0                    ld      (BALL_WAITING),a
