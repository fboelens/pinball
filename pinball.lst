    2408   00:4E09                      DrawFlipperFrame:
    2409   00:4E09                              ; SCREEN 5 packs two horizontal pixels per byte, hence 34 pixels=17
    2410   00:4E09                              ; bytes. Adding 128 bytes advances one complete 256-pixel scanline.
    2411   00:4E09  F3                          di
    2412   00:4E0A                              ; Destination bit 14 selects physical VRAM bank 0 or 1. The original
    2413   00:4E0A                              ; two instances both lived below Y=128 and could hardcode bank 1; map
    2414   00:4E0A                              ; instances may be anywhere on screen.
    2415   00:4E0A  7A                          ld      a,d
    2416   00:4E0B  E6 40                       and     040h
    2417   00:4E0D  07                          rlca
    2418   00:4E0E  07                          rlca                         ; D bit 6 -> R#14 value 0 or 1
    2419   00:4E0F  D3 99                       out     (099h),a
    2420   00:4E11  3E 8E                       ld      a,14+128
    2421   00:4E13  D3 99                       out     (099h),a
    2422   00:4E15  3E 17                       ld      a,23                 ; full pivot-aligned swept height
    2423   00:4E17                      .row:
