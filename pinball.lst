    2425   00:4E18  7B                          ld      a,e
    2426   00:4E19  D3 99                       out     (099h),a
    2427   00:4E1B  7A                          ld      a,d
    2428   00:4E1C  E6 3F                       and     03fh
    2429   00:4E1E  F6 40                       or      040h
    2430   00:4E20  D3 99                       out     (099h),a
    2431   00:4E22  0E 98                       ld      c,098h
    2432   00:4E24  06 11                       ld      b,17                 ; 34 SCREEN 5 pixels
    2433   00:4E26  ED B3                       otir
    2434   00:4E28  7B                          ld      a,e
    2435   00:4E29  C6 80                       add     a,128                ; next 256-pixel bitmap scanline
    2436   00:4E2B  5F                          ld      e,a
    2437   00:4E2C  30 01                       jr      nc,.noCarry
    2438   00:4E2E  14                          inc     d
    2439   00:4E2F                      .noCarry:
    2440   00:4E2F  F1                          pop     af
