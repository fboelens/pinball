     639   00:430E                      ; A=6 for '/', A=7 for '\\'; B/C are the sampled pixel coordinates.
     640   00:430E                      ResolveSlopeFloor:
     641   00:430E                              ; Each diagonal tile is an exact one-pixel height function. Comparing
     642   00:430E                              ; local Y with that height avoids treating its transparent half as solid.
     643   00:430E  32 0C C0                    ld      (BALL_SIDE),a
