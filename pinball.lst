    2199   00:4CD2  21 00 80                    ld      hl,08000h
    2200   00:4CD5  11 00 00                    ld      de,00000h
    2201   00:4CD8  01 00 40                    ld      bc,04000h
    2202   00:4CDB  CD 5C 00                    call    LDIRVM
    2203   00:4CDE  21 1F 79                    ld      hl,PlayfieldBank1
    2204   00:4CE1  11 00 80                    ld      de,08000h
    2205   00:4CE4  CD FC 4C                    call    UnpackPletterRAM
